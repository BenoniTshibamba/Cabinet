SQLITE_DB_PATH=./data/cabinet-elite.db
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES=8h
JWT_REFRESH_EXPIRES_DAYS=30
PORT=4000
UPLOAD_DIR=./uploads

# Assistant IA — une seule clé suffit (chat + embeddings).
# LLM_PROVIDER=gemini (défaut, clé gratuite : https://aistudio.google.com) ou openai.
# Sans LLM_API_KEY, l’assistant est désactivé (le reste de l’app fonctionne).
LLM_PROVIDER=gemini
LLM_API_KEY=
# LLM_CHAT_MODEL=gemini-2.5-flash
# LLM_EMBED_MODEL=text-embedding-004
# GEMINI_CHAT_MODEL=gemini-2.5-flash
# GEMINI_EMBED_MODEL=text-embedding-004

# --- Version officielle (production) : premier administrateur ---
# Au premier démarrage SANS `npm run seed`, le premier compte admin est créé
# automatiquement. Définissez ces variables pour choisir ses identifiants ;
# sinon un mot de passe aléatoire est généré et affiché une fois dans la console.
# ADMIN_EMAIL=contact@moncabinet.com
# ADMIN_NAME=Benoni Tshibamba
# ADMIN_PASSWORD=un-mot-de-passe-solide-ici

# --- Envoi de courriels (mot de passe oublié, notifications) ---
# Sans SMTP_HOST, l'envoi est désactivé silencieusement : l'app fonctionne,
# seuls les courriels ne partent pas (jamais de crash).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=votre-adresse@gmail.com
# SMTP_PASS=mot-de-passe-application-16-lettres
# MAIL_FROM=Cabinet Élite Juridique <votre-adresse@gmail.com>
# URL publique de l'app (utilisée dans les liens des courriels ; défaut = origine de la requête).
# APP_URL=https://cabinet-elite-juridique.onrender.com

# --- Connexion avec Google (OAuth 2.0, optionnel) ---
# Créez un ID client OAuth sur https://console.cloud.google.com (Identifiants),
# avec l'URI de redirection ci-dessous autorisée. Sans GOOGLE_CLIENT_ID,
# le bouton Google est masqué et les endpoints répondent 404 (jamais de crash).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://cabinet-elite-juridique.onrender.com/api/auth/google/callback
